# Copy this file to `.env` and replace the placeholder with your real connection string.
# Connection string for PostgreSQL.
# Requires PostgreSQL >= 15.

# Local dev (Docker, see docker-compose.yml): postgresql://myUSER:myPASSWORD@localhost:5433/expenso
# Production (Render): the Internal Database URL of your Render PostgreSQL instance
DATABASE_URL="postgresql://user:password@localhost:5432/mydb"

# Port the Express server listens on.
# Render injects PORT automatically in production; defaults to 3000 locally.
PORT=3000
