# Copy this file to .env (or .env.development / .env.production) and fill in the values.
# Vite only exposes variables prefixed with VITE_ to the browser code.
# Vite reads these files at startup: restart `npm run dev` after any change.

# Base URL of the backend API (no trailing slash, without /api)
#   dev:  http://localhost:3000
#   prod: https://<your-backend>.onrender.com
VITE_API_URL=http://localhost:3000
